# ======================================================
# KruKasyno – Ansible Inventory Example
# Copy to inventory.ini and fill in actual IP addresses
# ======================================================

[vps1]
vps1 ansible_host=YOUR_VPS1_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa

[vps2]
vps2 ansible_host=YOUR_VPS2_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa

[all:vars]
ansible_python_interpreter=/usr/bin/python3
